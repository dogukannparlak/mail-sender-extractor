# Mail Cleaner settings
# Usage: copy this file to .env (cp .env.example .env) and edit the values.
# .env is not committed. If you delete a line or comment it out with #, the default is used.
# A value given on the command line wins over .env: DEMO=1 python app.py

# Port the app listens on: http://localhost:<PORT>
PORT=5050

# Interface language: en or tr. Leave empty to follow the browser's language
# (the language picker in the page header still works and is remembered in a cookie).
LANGUAGE=

# 1 = demo mode with fake data (does not connect to Gmail), 0 = real Gmail
DEMO=0

# 1 = Flask debug mode (development only; the server restarts when code changes)
FLASK_DEBUG=0

# JSON files the app writes (scan_ids.json, last_action.json, protected.json, ...):
# 0 = readable (indented, split over lines), 1 = compact single line (smaller files)
COMPACT_FILES=0

# Optional SHARED OAuth client file. Normally not needed: every account connects with its own
# client_secret_….json through "+ Add account", and the file is stored in accounts/<address>/.
CREDENTIALS_PATH=credentials.json

# Account folders: every account gets <folder>/<address>/token.json and its own data.
# (Older versions used "hesaplar"; if your .env still says ACCOUNTS_DIR=hesaplar that folder is kept.)
ACCOUNTS_DIR=accounts

# ---------------------------------------------------------------------------
# ACCOUNTS
# Easiest: in the app click "+ Add account" › choose that account's client_secret_….json › sign in to Google.
# The client and token are written to accounts/<address>/ by themselves; you don't need to write anything below.
# How to create the client in Google Cloud: README › "Google Cloud setup".
#
# If you already have a token file (from another computer, from a backup): copy it into the tokens/ folder,
# rename it, remove the # at the start of a line below and write the address.
# Format: ACCOUNT_<number>=<email address>=<token file>
# The token must have been created with the gmail.modify scope (the client info is inside the token).
#
# Account 1: your current account. A token.json in the project root is moved to accounts/<address>/
# automatically on first start; you don't need to write it here.
# ACCOUNT_1=first@gmail.com=tokens/first.json
# ACCOUNT_2=second@gmail.com=tokens/second.json
# ACCOUNT_3=third@gmail.com=tokens/third.json
# ACCOUNT_4=fourth@gmail.com=tokens/fourth.json
#
# The same thing on one line (comma separated):
# EXTRA_ACCOUNTS=second@gmail.com=tokens/second.json, third@gmail.com=tokens/third.json
EXTRA_ACCOUNTS=

# Gmail quota: 6,000 units per minute per user (reading a message costs 20 units → ~300 messages/min).
# 5400 leaves a little headroom. 0 = unlimited (causes 429 errors on a real account).
GMAIL_QUOTA_PER_MINUTE=5400

# Default scope for moving to Trash and previews: inbox (inbox only) or all (archive and spam included)
DEFAULT_SCOPE=inbox
