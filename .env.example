# Mail Temizleyici ayarları
# Kullanım: bu dosyayı .env adıyla kopyala (cp .env.example .env) ve değerleri düzenle.
# .env git'e girmez. Bir satırı silersen ya da # ile kapatırsan varsayılan kullanılır.
# Komut satırında verilen değer .env'nin önüne geçer: DEMO=1 python app.py

# Uygulamanın açılacağı port: http://localhost:<PORT>
PORT=5050

# 1 = sahte verilerle demo modu (Gmail'e bağlanmaz), 0 = gerçek Gmail
DEMO=0

# 1 = Flask hata ayıklama modu (yalnız geliştirirken; kod değişince sunucu yeniden başlar)
FLASK_DEBUG=0

# Uygulamanın yazdığı JSON dosyaları (taranan_idler.json, son_islem.json, korunanlar.json):
# 0 = okunaklı (girintili, satırlara bölünmüş), 1 = sıkışık tek satır (daha küçük dosya)
COMPACT_FILES=0

# Google Cloud'dan indirdiğin OAuth istemci dosyası (göreli yol proje klasörüne göredir)
CREDENTIALS_PATH=credentials.json

# Hesap klasörleri: her hesap için <klasör>/<adres>/token.json ve o hesabın verileri
ACCOUNTS_DIR=hesaplar

# ---------------------------------------------------------------------------
# HESAPLAR
# En kolayı: uygulamada "+ Hesap ekle" (Google'a giriş yaparsın, token kendiliğinden
# hesaplar/<adres>/token.json olarak yazılır). O zaman aşağıya hiçbir şey yazman gerekmez.
#
# Token dosyan zaten varsa (başka bir bilgisayardan, yedekten): dosyayı tokenlar/ klasörüne
# kopyala, adını değiştir ve aşağıdaki satırın başındaki # işaretini kaldırıp adresi yaz.
# Biçim: ACCOUNT_<numara>=<mail adresi>=<token dosyası>
# Token, bu projedeki credentials.json ile ve gmail.modify izniyle oluşturulmuş olmalı.
#
# 1. hesap: şu anki hesabın. Kökteki token.json ilk açılışta hesaplar/<adresin>/ klasörüne
#    kendiliğinden taşınır; buraya yazman gerekmez.
# ACCOUNT_1=birinci@gmail.com=tokenlar/birinci.json
# ACCOUNT_2=ikinci@gmail.com=tokenlar/ikinci.json
# ACCOUNT_3=ucuncu@gmail.com=tokenlar/ucuncu.json
# ACCOUNT_4=dorduncu@gmail.com=tokenlar/dorduncu.json
#
# Aynı şey tek satırda da yazılabilir (virgülle ayrılmış):
# EXTRA_ACCOUNTS=ikinci@gmail.com=tokenlar/ikinci.json, ucuncu@gmail.com=tokenlar/ucuncu.json
EXTRA_ACCOUNTS=

# Gmail kotası: kullanıcı başına dakikada 6.000 birim (mail okuma 20 birim → ~300 mail/dk).
# Biraz pay bırakmak için 5400. 0 = sınırsız (gerçek hesapta 429 hatalarına yol açar).
GMAIL_QUOTA_PER_MINUTE=5400

# Taşıma ve önizlemenin varsayılan kapsamı: inbox (yalnız gelen kutusu) ya da all (arşiv dahil)
DEFAULT_SCOPE=inbox
