# Mail Temizleyici ayarları
# Kullanım: bu dosyayı .env adıyla kopyala (cp .env.example .env) ve değerleri düzenle.
# .env git'e girmez. Bir satırı silersen ya da # ile kapatırsan varsayılan kullanılır.
# Komut satırında verilen değer .env'nin önüne geçer: DEMO=1 python app.py

# Uygulamanın açılacağı port: http://localhost:<PORT>
PORT=5050

# 1 = sahte verilerle demo modu (Gmail'e bağlanmaz), 0 = gerçek Gmail
DEMO=0

# 1 = Flask hata ayıklama modu (yalnız geliştirirken; kod değişince sunucu yeniden başlar)
FLASK_DEBUG=0

# Google Cloud'dan indirdiğin OAuth istemci dosyası (göreli yol proje klasörüne göredir)
CREDENTIALS_PATH=credentials.json

# Hesap klasörleri: her hesap için <klasör>/<adres>/token.json ve o hesabın verileri
ACCOUNTS_DIR=hesaplar

# Token dosyası başka bir yerde duran hesaplar: adres=token_dosyası, virgülle ayrılmış.
# Bu hesapların verileri (gönderen listesi, geri alma) yine ACCOUNTS_DIR/<adres>/ altında tutulur.
# Uygulamadaki "+ Hesap ekle" ile eklediklerini buraya yazman gerekmez.
# Örnek: EXTRA_ACCOUNTS=okul@ogr.ornek.edu.tr=~/tokenlar/okul.json, is@ornek.com=~/tokenlar/is.json
EXTRA_ACCOUNTS=

# Gmail kotası: kullanıcı başına dakikada 6.000 birim (mail okuma 20 birim → ~300 mail/dk).
# Biraz pay bırakmak için 5400. 0 = sınırsız (gerçek hesapta 429 hatalarına yol açar).
GMAIL_QUOTA_PER_MINUTE=5400

# Taşıma ve önizlemenin varsayılan kapsamı: inbox (yalnız gelen kutusu) ya da all (arşiv dahil)
DEFAULT_SCOPE=inbox
